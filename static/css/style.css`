/* =========================================================================
   Co-opSeva Premium 3D Design System
   A modern, high-fidelity interface focusing on depth, glassmorphism,
   and professional 3D micro-interactions.
   ========================================================================= */

:root {
  /* ---- Premium Palette --------------------------------------------------- */
  --bg-main: #f8fafc;           /* Light Slate 50 */
  --bg-secondary: #f1f5f9;      /* Light Slate 100 */
  --surface: rgba(255, 255, 255, 0.7);
  --surface-border: rgba(226, 232, 240, 0.8);
  --text-main: #0f172a;         /* Slate 900 */
  --text-muted: #64748b;        /* Slate 500 */
  --text-light: #f8fafc;

  --primary: #6366f1;           /* Indigo 500 */
  --primary-hover: #4f46e5;     /* Indigo 600 */
  --primary-deep: #3730a3;      /* Indigo 800 */
  --primary-tint: rgba(99, 102, 241, 0.1);

  --accent: #f59e0b;            /* Amber 500 */
  --accent-hover: #d97706;      /* Amber 600 */
  --accent-deep: #b45309;       /* Amber 700 */
  --accent-tint: rgba(245, 158, 11, 0.1);

  --danger: #ef4444;            /* Red 500 */
  --danger-deep: #b91c1c;       /* Red 700 */

  /* ---- 3D & Depth System ------------------------------------------------- */
  --shadow-sm: 0 2px 4px rgba(15, 23, 42, 0.05);
  --shadow-md: 0 10px 25px -5px rgba(15, 23, 42, 0.1), 0 8px 10px -6px rgba(15, 23, 42, 0.1);
  --shadow-lg: 0 20px 50px -12px rgba(15, 23, 42, 0.15);
  --shadow-inner: inset 0 2px 4px 0 rgba(0, 0, 0, 0.06);

  --radius-sm: 8px;
  --radius-md: 16px;
  --radius-lg: 24px;
  --radius-full: 9999px;

  /* ---- Typography -------------------------------------------------------- */
  --font-display: 'Fraunces', serif;
  --font-body: 'Work Sans', system-ui, -apple-system, sans-serif;
  --font-mono: 'IBM Plex Mono', monospace;

  --container: 1240px;
  --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-bounce: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* Role-based Theme Overrides (Maintaining Functionality) */
.theme-customer {
  --primary: #3b82f6; --primary-hover: #2563eb; --primary-deep: #1e3a8a; --primary-tint: rgba(59, 130, 246, 0.1);
}
.theme-worker {
  --primary: #10b981; --primary-hover: #059669; --primary-deep: #064e3b; --primary-tint: rgba(16, 185, 129, 0.1);
}
.theme-society {
  --primary: #f97316; --primary-hover: #ea580c; --primary-deep: #7c2d12; --primary-tint: rgba(249, 115, 22, 0.1);
}
.theme-platform_admin, .theme-federation, .theme-support, .theme-finance, .theme-welfare {
  --primary: #8b5cf6; --primary-hover: #7c3aed; --primary-deep: #4c1d95; --primary-tint: rgba(139, 92, 246, 0.1);
}

*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; }

body {
  margin: 0;
  background: var(--bg-main);
  color: var(--text-main);
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

/* Global Typography */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-display);
  color: var(--text-main);
  line-height: 1.2;
  margin: 0 0 0.5em;
  font-weight: 700;
}
h1 { font-size: clamp(2.5rem, 5vw, 3.5rem); letter-spacing: -0.02em; }
h2 { font-size: clamp(1.8rem, 3vw, 2.5rem); letter-spacing: -0.01em; }
h3 { font-size: 1.5rem; }
p { margin: 0 0 1em; color: var(--text-muted); }

.container {
  max-width: var(--container);
  margin: 0 auto;
  padding: 0 24px;
}

/* -------------------------------------------------------------------------
   Core UI Components
   ------------------------------------------------------------------------- */

/* Premium Buttons */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  padding: 12px 24px; border-radius: var(--radius-full); font-weight: 600; font-size: 0.95rem;
  border: 1px solid transparent; transition: var(--transition-bounce);
  cursor: pointer; white-space: nowrap;
  position: relative; overflow: hidden;
  z-index: 1;
}

.btn:active { transform: scale(0.96); }

.btn-primary {
  background: var(--primary); color: var(--text-light);
  box-shadow: 0 4px 12px var(--primary-tint);
}
.btn-primary:hover {
  background: var(--primary-hover);
  box-shadow: 0 6px 20px var(--primary-tint);
  transform: translateY(-2px);
}

.btn-accent {
  background: var(--accent); color: var(--text-main);
  box-shadow: 0 4px 12px var(--accent-tint);
}
.btn-accent:hover {
  background: var(--accent-hover);
  box-shadow: 0 6px 20px var(--accent-tint);
  transform: translateY(-2px);
}

.btn-outline {
  background: transparent; border-color: var(--surface-border); color: var(--text-main);
}
.btn-outline:hover {
  background: var(--bg-secondary); border-color: var(--text-muted);
  transform: translateY(-2px);
}

.btn-ghost {
  background: transparent; color: var(--text-muted);
}
.btn-ghost:hover {
  background: var(--bg-secondary); color: var(--text-main);
}

.btn-sm { padding: 8px 16px; font-size: 0.85rem; }

/* 3D Cards & Glassmorphism */
.card {
  background: var(--surface);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius-md);
  padding: 24px;
  transition: var(--transition-smooth);
  box-shadow: var(--shadow-sm);
}

.card-link { text-decoration: none; color: inherit; display: block; perspective: 1000px; }

.card-link:hover .card {
  transform: translateY(-8px) rotateX(2deg) rotateY(1deg);
  box-shadow: var(--shadow-lg);
  border-color: var(--primary-tint);
  background: rgba(255, 255, 255, 0.9);
}

/* Special Glass Components */
.glass {
  background: var(--surface);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--surface-border);
  box-shadow: var(--shadow-md);
}

/* -------------------------------------------------------------------------
   Header & Navigation
   ------------------------------------------------------------------------- */
.topbar {
  background: var(--text-main); color: var(--text-light);
  font-size: 0.75rem; font-weight: 500; padding: 6px 0;
}
.topbar .container { display: flex; align-items: center; justify-content: space-between; }

.site-header {
  background: rgba(248, 250, 252, 0.8);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--surface-border);
  position: sticky; top: 0; z-index: 100;
  transition: var(--transition-smooth);
}
.site-header .container {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 24px;
}

.brand {
  display: flex; align-items: center; gap: 12px;
  font-family: var(--font-display); font-weight: 800; font-size: 1.5rem;
  transition: var(--transition-smooth);
}
.brand:hover { transform: scale(1.02); }
.brand-mark { height: 48px; width: auto; transition: var(--transition-smooth); }
.brand:hover .brand-mark { transform: rotate(-5deg) scale(1.1); }
.brand-text {
  background: linear-gradient(135deg, var(--primary-deep), var(--primary);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
}
.brand-sub {
  display: block; font-family: var(--font-body); font-weight: 600;
  font-size: 0.6rem; text-transform: uppercase; color: var(--text-muted);
  letter-spacing: 0.1em;
}

.main-nav { display: flex; align-items: center; gap: 32px; }
.main-nav a {
  font-weight: 500; font-size: 0.9rem; color: var(--text-muted);
  transition: var(--transition-smooth); position: relative;
}
.main-nav a:hover, .main-nav a.active { color: var(--primary); }
.main-nav a::after {
  content: ''; position: absolute; bottom: -4px; left: 0; width: 0; height: 2px;
  background: var(--primary); transition: var(--transition-smooth);
}
.main-nav a:hover::after, .main-nav a.active::after { width: 100%; }

.header-actions { display: flex; align-items: center; gap: 12px; }

/* -------------------------------------------------------------------------
   Hero Section
   ------------------------------------------------------------------------- */
.hero {
  padding: 100px 0 120px;
  background: radial-gradient(circle at top right, var(--primary-tint), transparent 40%),
              radial-gradient(circle at bottom left, var(--accent-tint), transparent 40%),
              var(--bg-main);
  position: relative; overflow: hidden;
}
.hero .container {
  display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 60px; align-items: center;
}
.hero-eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--surface); border: 1px solid var(--surface-border);
  padding: 6px 16px; border-radius: var(--radius-full); font-size: 0.75rem;
  font-weight: 700; text-transform: uppercase; color: var(--primary);
  margin-bottom: 24px; box-shadow: var(--shadow-sm);
}
.hero h1 { margin-bottom: 24px; line-height: 1.1; }
.hero p.lead { font-size: 1.2rem; max-width: 52ch; margin-bottom: 32px; }
.hero-actions { display: flex; gap: 16px; flex-wrap: wrap; }

.hero-stats { display: flex; gap: 32px; margin-top: 48px; }
.hero-stat {
  display: flex; flex-direction: column;
  animation: float 3s ease-in-out infinite;
}
.hero-stat:nth-child(2) { animation-delay: 0.5s; }
.hero-stat:nth-child(3) { animation-delay: 1s; }

.hero-stat b {
  font-family: var(--font-display); font-size: 2rem; color: var(--primary);
  display: block; line-height: 1;
}
.hero-stat span { font-size: 0.85rem; color: var(--text-muted); font-weight: 500; }

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

.hero-search {
  background: var(--surface);
  backdrop-filter: blur(20px);
  border: 1px solid var(--surface-border);
  border-radius: var(--radius-lg);
  padding: 32px;
  box-shadow: var(--shadow-lg);
  transition: var(--transition-smooth);
}
.hero-search:hover { transform: translateY(-5px) rotateX(2deg); }
.hero-search h3 { margin-bottom: 20px; text-align: center; }
.hero-search form { display: flex; gap: 12px; }

/* -------------------------------------------------------------------------
   Modern Price Ticket (Digital Voucher Style)
   ------------------------------------------------------------------------- */
.price-ticket {
  margin-top: 24px;
  background: var(--bg-secondary);
  border: 2px dashed var(--surface-border);
  border-radius: var(--radius-md);
  padding: 20px;
  position: relative;
  transition: var(--transition-smooth);
}
.price-ticket:hover { border-color: var(--primary); background: var(--white); }
.price-ticket::before {
  content: "OFFICIAL TARIFF";
  position: absolute; top: -12px; left: 20px;
  background: var(--primary); color: var(--text-light);
  font-size: 0.65rem; font-weight: 800; padding: 3px 10px;
  border-radius: var(--radius-full); text-transform: uppercase;
}
.price-ticket-row {
  display: flex; justify-content: space-between;
  padding: 6px 0; font-size: 0.9rem; color: var(--text-muted);
  border-bottom: 1px solid var(--surface-border);
}
.price-ticket-row:last-of-type { border-bottom: none; }
.price-ticket-row.total {
  margin-top: 12px; padding-top: 12px;
  font-weight: 800; font-size: 1.1rem; color: var(--text-main);
  border-top: 2px solid var(--surface-border);
}
.price-ticket-note {
  font-size: 0.75rem; color: var(--text-muted); margin-top: 12px;
  text-align: center; font-style: italic;
}

/* -------------------------------------------------------------------------
   Sections & Grids
   ------------------------------------------------------------------------- */
.section { padding: 80px 0; }
.section-alt { background: var(--bg-secondary); }
.section-head {
  display: flex; align-items: flex-end; justify-content: space-between;
  margin-bottom: 48px; gap: 24px; flex-wrap: wrap;
}
.eyebrow {
  font-size: 0.75rem; font-weight: 800; text-transform: uppercase;
  color: var(--primary); letter-spacing: 0.1em; margin-bottom: 8px; display: block;
}

.grid { display: grid; gap: 24px; }
.grid-4 { grid-template-columns: repeat(4, 1fr); }
.grid-3 { grid-template-columns: repeat(3, 1fr); }
.grid-2 { grid-template-columns: repeat(2, 1fr); }

.category-card { text-align: left; }
.category-icon {
  width: 64px; height: 64px; border-radius: var(--radius-md);
  background: var(--primary-tint); display: flex; align-items: center; justify-content: center;
  margin-bottom: 20px; transition: var(--transition-smooth);
}
.category-card:hover .category-icon {
  background: var(--primary); color: var(--text-light);
  transform: rotateY(180deg);
}
.category-icon svg { width: 32px; height: 32px; color: var(--primary); stroke: var(--primary); }
.category-card:hover .category-icon svg { color: var(--text-light); stroke: var(--text-light); }

.worker-card { display: flex; flex-direction: column; gap: 16px; }
.worker-card-top { display: flex; gap: 16px; align-items: center; }
.worker-avatar {
  width: 64px; height: 64px; border-radius: var(--radius-full);
  background: var(--primary-tint); display: flex; align-items: center; justify-content: center;
  overflow: hidden; flex-shrink: 0; color: var(--primary);
  font-family: var(--font-display); font-weight: 700; font-size: 1.4rem;
  border: 3px solid var(--white); box-shadow: var(--shadow-sm);
}
.worker-avatar img { width: 100%; height: 100%; object-fit: cover; }

.badge {
  display: inline-flex; align-items: center; gap: 4px; font-size: 0.7rem; font-weight: 700;
  padding: 4px 10px; border-radius: var(--radius-full); text-transform: uppercase;
}
.badge-verified { background: var(--primary-tint); color: var(--primary); }
.badge-warning { background: var(--accent-tint); color: var(--accent-deep); }
.badge-danger { background: rgba(239, 68, 68, 0.1); color: var(--danger); }
.badge svg { width: 12px; height: 12px; }

.rating-row { display: flex; align-items: center; gap: 6px; font-size: 0.9rem; color: var(--text-muted); }
.rating-row svg { width: 16px; height: 16px; color: var(--accent); fill: var(--accent); }

/* -------------------------------------------------------------------------
   Steps Process
   ------------------------------------------------------------------------- */
.steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
.step {
  position: relative; padding: 32px; background: var(--surface);
  border-radius: var(--radius-md); border: 1px solid var(--surface-border);
  transition: var(--transition-smooth);
}
.step:hover { transform: translateY(-10px); box-shadow: var(--shadow-lg); }
.step .step-num {
  font-family: var(--font-display); font-size: 3rem; color: var(--primary);
  opacity: 0.2; position: absolute; top: 10px; right: 20px; font-weight: 800;
}

/* -------------------------------------------------------------------------
   Forms
   ------------------------------------------------------------------------- */
.form-card {
  background: var(--surface); border: 1px solid var(--surface-border);
  border-radius: var(--radius-lg); padding: 40px; max-width: 500px;
  margin: 0 auto; box-shadow: var(--shadow-lg); backdrop-filter: blur(10px);
}
.form-card.wide { max-width: 800px; }
.form-group { margin-bottom: 24px; }
.form-group label { display: block; font-weight: 600; font-size: 0.9rem; margin-bottom: 8px; color: var(--text-main); }
.input-field {
  width: 100%; padding: 12px 16px; border-radius: var(--radius-sm);
  border: 1px solid var(--surface-border); background: var(--white);
  font-family: var(--font-body); font-size: 1rem; color: var(--text-main);
  transition: var(--transition-smooth);
}
.input-field:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 4px var(--primary-tint); }

/* -------------------------------------------------------------------------
   Tables
   ------------------------------------------------------------------------- */
.table-wrap {
  overflow-x: auto; border-radius: var(--radius-md);
  border: 1px solid var(--surface-border); background: var(--white);
  box-shadow: var(--shadow-sm);
}
table.data-table { width: 100%; border-collapse: collapse; }
table.data-table th {
  background: var(--bg-secondary); color: var(--text-main);
  font-weight: 700; text-align: left; padding: 16px; font-size: 0.85rem;
  text-transform: uppercase; letter-spacing: 0.05em;
}
table.data-table td { padding: 16px; border-bottom: 1px solid var(--surface-border); font-size: 0.9rem; }

/* -------------------------------------------------------------------------
   Footer
   ------------------------------------------------------------------------- */
.site-footer { background: var(--text-main); color: var(--text-light); padding: 80px 0 40px; margin-top: 80px; }
.footer-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 40px; }
.site-footer h4 { color: var(--text-light); font-family: var(--font-body); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 20px; }
.site-footer a { color: var(--text-muted); font-size: 0.9rem; display: block; margin-bottom: 12px; transition: var(--transition-smooth); }
.site-footer a:hover { color: var(--primary); transform: translateX(5px); }
.footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.1); margin-top: 48px; padding-top: 24px;
  display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--text-muted); flex-wrap: wrap; gap: 16px;
}

/* -------------------------------------------------------------------------
   AI Chat Floating (Modernized)
   ------------------------------------------------------------------------- */
.ai-chat-floating {
  position: fixed; bottom: 32px; right: 32px; display: flex; flex-direction: column;
  align-items: center; gap: 12px; z-index: 9999;
}
.ai-chat-label {
  background: var(--white); color: var(--primary); font-size: 0.7rem; font-weight: 800;
  padding: 6px 12px; border-radius: var(--radius-full); box-shadow: var(--shadow-md);
  animation: ai-bounce 2s ease-in-out infinite; border: 1px solid var(--surface-border);
}
.ai-chat-button {
  width: 56px; height: 56px; border-radius: 50%; background: var(--primary);
  color: var(--text-light); border: none; display: flex; align-items: center;
  justify-content: center; cursor: pointer; box-shadow: 0 8px 20px var(--primary-tint);
  transition: var(--transition-bounce);
}
.ai-chat-button:hover { transform: scale(1.1) rotate(10deg); background: var(--primary-hover); }
.ai-chat-button svg { width: 24px; height: 24px; fill: currentColor; }

.ai-chat-window {
  position: fixed; bottom: 100px; right: 32px; width: 360px; height: 500px;
  background: var(--surface); backdrop-filter: blur(20px);
  border: 1px solid var(--surface-border); border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg); display: none; flex-direction: column;
  z-index: 9999; animation: window-appear 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
.ai-chat-window.open { display: flex; }
@keyframes window-appear { from { opacity: 0; transform: translateY(30px) scale(0.9); } to { opacity: 1; transform: translateY(0) scale(1); } }

.ai-chat-header {
  background: var(--primary); color: var(--text-light); padding: 16px 20px;
  font-family: var(--font-display); font-weight: 600; display: flex; justify-content: space-between;
}
.ai-chat-messages { flex: 1; padding: 20px; overflow-y: auto; display: flex; flex-direction: column; gap: 16px; background: var(--bg-main); }
.ai-msg, .user-msg { max-width: 85%; padding: 12px 16px; border-radius: var(--radius-sm); font-size: 0.9rem; box-shadow: var(--shadow-sm); }
.ai-msg { background: var(--white); align-self: flex-start; border-bottom-left-radius: 2px; }
.user-msg { background: var(--primary); color: var(--text-light); align-self: flex-end; border-bottom-right-radius: 2px; }
.ai-chat-input-area { padding: 16px; background: var(--surface); border-top: 1px solid var(--surface-border); display: flex; gap: 12px; }
.ai-chat-input { flex: 1; padding: 10px 16px; border: 1px solid var(--surface-border); border-radius: var(--radius-full); font-size: 0.9rem; }
.ai-chat-send { background: var(--primary); color: var(--text-light); border: none; padding: 0 16px; border-radius: var(--radius-full); font-weight: 600; cursor: pointer; }

@keyframes ai-bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }

/* -------------------------------------------------------------------------
   Responsive Design
   ------------------------------------------------------------------------- */
@media (max-width: 1024px) {
  .hero .container { grid-template-columns: 1fr; text-align: center; }
  .hero-actions { justify-content: center; }
  .hero-stats { justify-content: center; }
  .grid-4 { grid-template-columns: repeat(2, 1fr); }
  .grid-3 { grid-template-columns: repeat(2, 1fr); }
  .steps { grid-template-columns: repeat(2, 1fr); }
  .footer-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 768px) {
  .main-nav {
    position: fixed; inset: 64px 0 0 0; background: var(--bg-main);
    flex-direction: column; align-items: flex-start; padding: 32px;
    transform: translateX(100%); transition: var(--transition-smooth);
  }
  .main-nav.open { transform: translateX(0); }
  .main-nav a { width: 100%; padding: 16px 0; border-bottom: 1px solid var(--surface-border); }
  .nav-toggle { display: inline-flex; }
  .grid-3, .grid-2 { grid-template-columns: 1fr; }
  .steps { grid-template-columns: 1fr; }
  .footer-grid { grid-template-columns: 1fr; }
  .hero h1 { font-size: 2.2rem; }
}
